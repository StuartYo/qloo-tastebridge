# Qloo hackathon key (only works on https://hackathon.api.qloo.com). Leave empty to run on mock demo data.
# Server-side only: never prefix with NEXT_PUBLIC_.
QLOO_API_KEY=
# optional: live | snapshot | mock (default: live when a key is set, otherwise mock; snapshot = cache only)
QLOO_MODE=
# optional: private response cache (default .cache/qloo, git-ignored; never commit Qloo data). "off" disables it.
QLOO_CACHE_DIR=
QLOO_CACHE=
# optional: max live Qloo calls per server process per day (default 2000; key quota is 10,000/month)
QLOO_DAILY_CALL_CAP=

# Claude for the agent loop, the "LLM only" column and the Taste Bridge explanations.
# Leave empty to use the rules-based agent (still on live Qloo data).
ANTHROPIC_API_KEY=
# Agent loop + "LLM only" baseline (same model on both sides of the comparison)
TASTEBRIDGE_MODEL=claude-sonnet-5-5
# Short grounded writing steps (Taste Bridge "why you'd like it")
TASTEBRIDGE_SMALL_MODEL=claude-haiku-5-5
# Agent effort: low | medium | high
TASTEBRIDGE_EFFORT=medium

# LLM spend caps for the public demo (per server instance). When a cap is hit, preset examples are served
# from the pre-generated bundle and other inputs get the rules-based agent on live Qloo data.
LLM_VISITOR_DAILY_RUNS=2
LLM_DAILY_RUNS=8
LLM_DAILY_USD=0.25

# Per-visitor caps on analyses of any kind (daily, and per minute)
DEMO_DAILY_LIMIT=30
DEMO_BURST_PER_MINUTE=6

# Pre-generated results for the preset examples (contains Qloo-derived data, so never in git).
# .data/showcase.json (git-ignored) is read automatically; SHOWCASE_FILE overrides the path.
# On Vercel it ships inside the private deployment, uploaded from the local folder by `vercel deploy`.
SHOWCASE_FILE=
